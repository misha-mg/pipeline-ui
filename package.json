{
  "name": "pipeline-ui",
  "private": true,
  "type": "module",
  "description": "Web console for the webui ticket pipeline: queue, loop, run in flight, run history",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "session": "node server/session/main.ts",
    "pipeline": "node --no-warnings=ExperimentalWarning server/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^4"
  }
}
