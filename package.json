{
  "name": "pipeline-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Web console for the webui ticket pipeline: queue, loop, run in flight, run history",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "bin/pipeline serve",
    "check": "tsc --noEmit && vue-tsc --noEmit -p ui/tsconfig.json && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build --config ui/vite.config.ts",
    "dev": "vite --config ui/vite.config.ts",
    "pipeline": "node --no-warnings=ExperimentalWarning server/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "^5.9",
    "vite": "^7.3.7",
    "vitest": "^4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
